# ============================================
# VeerAlyze - Environment Variables Template
# Copy this file to .env and fill in your keys
# ============================================

# Gemini API Keys (up to 20 for fallback rotation)
GEMINI_API_KEY_1=your_gemini_api_key_1
GEMINI_API_KEY_2=your_gemini_api_key_2
GEMINI_API_KEY_3=your_gemini_api_key_3
GEMINI_API_KEY_4=your_gemini_api_key_4
GEMINI_API_KEY_5=your_gemini_api_key_5
GEMINI_API_KEY_6=your_gemini_api_key_6
GEMINI_API_KEY_7=your_gemini_api_key_7
GEMINI_API_KEY_8=your_gemini_api_key_8
GEMINI_API_KEY_9=your_gemini_api_key_9
GEMINI_API_KEY_10=your_gemini_api_key_10

# Dedicated Gemini Keys for AI Chat
GEMINI_CHAT_KEY_1=your_gemini_chat_key_1
GEMINI_CHAT_KEY_2=your_gemini_chat_key_2
GEMINI_CHAT_KEY_3=your_gemini_chat_key_3
GEMINI_CHAT_KEY_4=your_gemini_chat_key_4

# Groq (fallback AI chat)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Google OAuth (YouTube linking)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://your-render-url.onrender.com/api/youtube/oauth2callback
YOUTUBE_VIDEO_FETCH_LIMIT=100

# App Settings
PORT=3000
GEMINI_MODEL=gemini-2.5-flash

# Manus AI (optional)
MANUS_API_KEY=your_manus_api_key_here
